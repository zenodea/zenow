{
  "name": "reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @reader/db generate",
    "db:migrate": "pnpm --filter @reader/db migrate",
    "db:studio": "pnpm --filter @reader/db studio",
    "dev:db": "docker compose up -d postgres",
    "dev:web": "pnpm --filter @reader/web dev",
    "dev:worker": "pnpm --filter @reader/worker dev"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
