# Neon pooled connection string
DATABASE_URL=

# Neon Auth: `neon link` writes the base url into the repo-root .env.local.
# The cookie secret is yours: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Where the shared worker lives, and the secret it checks on /kick.
# Both optional: without them saves still work, the worker just picks them
# up on its next poll instead of immediately.
WORKER_URL=
WORKER_SECRET=

# Provisioning a tenant's worker onto their own Fly account.
# WORKER_IMAGE must be a publicly pullable image of apps/worker.
WORKER_IMAGE=ghcr.io/your-account/zenow-worker:latest
PUBLIC_APP_URL=https://zenow.vercel.app
FLY_REGION=lhr

# 32 bytes of base64; encrypts tenant credentials at rest
CREDENTIALS_KEY=
