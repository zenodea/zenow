{
  "name": "@zenow/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3007",
    "build": "pnpm --filter @zenow/web^... build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "token": "node --env-file-if-exists=../../.env.local scripts/token.mjs",
    "test": "echo \"no tests in @zenow/web\"",
    "adopt": "node --env-file-if-exists=../../.env.local scripts/adopt-legacy.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@zenow/db": "workspace:*",
    "@zenow/shared": "workspace:*",
    "iron-session": "^9.0.1",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
