{
  "name": "@zenow/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fixtures:refresh": "node scripts/refresh-fixtures.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@zenow/shared": "workspace:*",
    "execa": "^9.6.0",
    "linkedom": "^0.18.12",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
