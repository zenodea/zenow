# Direct (non-pooler) Neon url; the claim query wants prepared statements
DATABASE_URL_UNPOOLED=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter slug. google/gemini-2.5-flash-lite is ~10x cheaper and has a
# 1M context window; anthropic/claude-haiku-4.5 writes better summaries.
LLM_MODEL=anthropic/claude-haiku-4.5

# Must match the value set on Vercel, or /kick is rejected
WORKER_SECRET=

PORT=8080
CONCURRENCY=3

# Reddit refuses unauthenticated json, so reddit links need a script-type app
# from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Encryption key for tenant credentials, shared with the web app.
# Only needed on a SHARED worker, which decrypts each tenant's key per job.
# A worker dedicated to one tenant sets OPENROUTER_API_KEY instead.
CREDENTIALS_KEY=

# YouTube refuses datacenter IPs. Paste a Netscape cookies.txt exported from a
# signed-in browser to get past it, or run this worker on a home connection.
YOUTUBE_COOKIES=
