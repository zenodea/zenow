# Neon pooled connection string (Vercel injects this via the Neon integration)
DATABASE_URL=

# 32+ random chars; signs the browser session cookie
SESSION_SECRET=

# Output of: pnpm --filter @reader/web passphrase
LOGIN_PASSPHRASE_HASH=

# Where the Fly worker lives, and the secret it checks on /kick.
# Both optional: without them saves still work, the worker just picks them
# up on its next poll instead of immediately.
WORKER_URL=
WORKER_SECRET=
